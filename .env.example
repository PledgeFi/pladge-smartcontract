DEPLOYER_PRIVATE_KEY=
# Use a dedicated RPC provider. The public endpoint is fine for reads but rate limits during deploys.
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
ETHERSCAN_API_KEY=

# --- Robinhood Mainnet 4663, deployed 2026-09-09 ---
# Canonical manifest: deployments/4663.json
# Filled in step by step: each script/mainnet/NN_*.s.sol prints the export lines for the next step.
PLEDGE_ORACLE_PROXY=0xB11951Dba2A7cAF846e0A3484237d8E5844428b7
PLEDGE_ORACLE_IMPL=0x428AceFE3bc2Da5a4B9b1615Ae066Bf81Be794cc
PLEDGE_SURPLUS_PROXY=0xc6D477491ACE30fa5651ac61C735C2B636B095c4
PLEDGE_SURPLUS_IMPL=0x5df0d2c7aB8443f41B84e684027eEB656e303C12
PLEDGE_VAULT_PROXY=0x83B6F15BD3A7385C0F55BA3C685f688511279B00
PLEDGE_VAULT_IMPL=0x0b8E032242A54a5373aed9968FEF01a9A0e0ec6F
PLEDGE_POOL_PROXY=0xf70D2a727E72b6890Bd269f5f8AdE7c86F3D244D
