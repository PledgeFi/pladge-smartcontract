# Step 08: seed the vault's USDG inventory. Native 6-decimal units, so 10000000 is 10 USDG.
# PLEDGE_FUND_AMOUNT=10000000

# Step 09: smoke test sizing. Collateral is 18dp NVDA, borrow is 6dp USDG.
# 50000000000000000 is 0.05 NVDA; 2000000 is 2 USDG.
# PLEDGE_SMOKE_COLLATERAL=50000000000000000
# PLEDGE_SMOKE_BORROW=2000000

# Step 11: irreversible ownership handover. Verify this address on the Safe UI before broadcasting.
# PLEDGE_TIMELOCK=0x1195e53E30A7645edf1EE7171B5C1CC0e55ebbFD
